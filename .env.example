# Server
PORT=8080
HOST=0.0.0.0
API_KEY=
MODEL_ALIAS=
ENABLE_WEBUI=true

# Model selection: no model is bundled or assumed.
# Choose ONE model by setting MODEL_REPO and MODEL_FILE.
# Example 1: lightweight SmolLM2
# MODEL_REPO=unsloth/SmolLM2-360M-Instruct-GGUF
# MODEL_FILE=SmolLM2-360M-Instruct-Q4_K_M.gguf
# MODEL_ALIAS=SmolLM2-360M-Instruct

# Example 2: Qwen2.5 0.5B Instruct
# MODEL_REPO=Qwen/Qwen2.5-0.5B-Instruct-GGUF
# MODEL_FILE=qwen2.5-0.5b-instruct-q4_k_m.gguf
# MODEL_ALIAS=Qwen2.5-0.5B-Instruct

MODEL_REPO=
MODEL_FILE=
MODEL_REVISION=main
# HF_TOKEN=

# Optional local model path. If set and the file exists, it is used instead of downloading.
MODEL_PATH=
MODEL_DIR=/models
DOWNLOAD_MODEL=true

# Low-resource CPU tuning
CPU_THREADS=2
CPU_THREADS_BATCH=2
CONTEXT_SIZE=2048
BATCH_SIZE=256
UBATCH_SIZE=128
PARALLEL=1

# Optional runtime behavior
LLAMA_SERVER_BIN=llama-server
LLAMA_SERVER_ARGS=
LOG_VERBOSITY=3
CORS_ORIGINS=
