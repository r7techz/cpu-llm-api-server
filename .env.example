# Server
PORT=8080
HOST=0.0.0.0
API_KEY=
MODEL_ALIAS=

# Model selection: no model is bundled or assumed.
# Set MODEL_REPO and MODEL_FILE to the exact Hugging Face model you want.
MODEL_REPO=
MODEL_FILE=
MODEL_REVISION=main
# HF_TOKEN=

# Optional local model path. If set and the file exists, it is used instead of downloading.
MODEL_PATH=
MODEL_DIR=/models
DOWNLOAD_MODEL=true

# Low-resource CPU tuning
CPU_THREADS=2
CPU_THREADS_BATCH=2
CONTEXT_SIZE=2048
BATCH_SIZE=256
UBATCH_SIZE=128
PARALLEL=1

# Optional runtime behavior
LLAMA_SERVER_BIN=llama-server
LLAMA_SERVER_ARGS=
LOG_VERBOSITY=3
CORS_ORIGINS=
